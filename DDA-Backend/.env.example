PORT=5000
NODE_ENV=production
# PostgreSQL connection string (e.g. Neon, Render, Supabase, AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/digital_document_assistant?sslmode=require
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# NVIDIA API keys (Server-side ONLY; kept secret)
NVIDIA_API_KEY=nvapi-...
ASSISTANT_NVIDIA_API_KEY=nvapi-...

# Persistent Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

